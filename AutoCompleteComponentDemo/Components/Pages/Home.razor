@page "/"
@rendermode InteractiveServer

<PageTitle>Auto Complete Component Home</PageTitle>

<h1>Demo!</h1>

<div class="d-flex flex-column gap-5 mt-5">
  <div class="form-group">
    <label class="form-label">Static Options Single Choice from string list</label>
    <StaticSingleAutoComplete Options="@StringOptions.ToAutoCompleteOptions()" @bind-Value="@SelectedStringValue"
                              CloseDropdownOnSelect="false" />
  </div>
  <div class="form-group">
    <label class="form-label">Static Options Multi Choice from enum with auto close when option is selected</label>
    <StaticMultiAutoComplete Options="@EnumExample.Option1.ToAutoCompleteOptions()" CloseDropdownOnSelect
                             @bind-Value="@SelectedEnumValues" />
  </div>
  <div class="form-group">
    <label class="form-label">Async Options Single Choice from list of SampleData and with custom dropdown label</label>
    <AsyncSingleAutoComplete OnSearch="@LoadSampleDataOptionsAsync" @bind-Value="@SelectedSampleDataValue"
                             CloseDropdownOnSelect="false">
      <SelectedItemTemplate Context="selectedOption">
        @selectedOption.Data.GetCustomSelectedLabel()
      </SelectedItemTemplate>
      <DropdownOptionTemplate Context="option">
        @option.Data.GetCustomDropDownLabel()
      </DropdownOptionTemplate>
    </AsyncSingleAutoComplete>
  </div>
</div>
